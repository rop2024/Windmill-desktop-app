{
  "name": "chess-desktop",
  "private": true,
  "type": "module",
  "version": "1.0.1",
  "description": "Chess desktop app built with Electron, React, and TypeScript",
  "main": ".electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "seed": "tsx scripts/seed.ts --db ./chess.db --count 50000"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.0",
    "better-sqlite3": "^11.9.1",
    "chess.js": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.47",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "build": {
    "productName": "Chess Desktop",
    "appId": "com.chess.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/",
      ".electron/",
      "resources/",
      "node_modules/better-sqlite3/**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/stockfish",
        "to": "resources/stockfish",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}
